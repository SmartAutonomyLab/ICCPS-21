function [A, delta, c] = test_function(F, G, FPR, c, plotOn)

if nargin < 5
    plotOn = 1;
    close all
end
if nargin < 4
    c = 0.5 * D ;
end
X = [];
Y = [];
m = 1;
n = 1;
X(1) = normrnd(F(1),F(2));
Y(1) = normrnd(G(1),G(2));

[Fn,x_f] = ecdf(X);
[Gn,x_g] = ecdf(Y);

Hdc(1) = kolmcdf((D-c)*sqrt(m*n/(m+n)));
Hc(1) = kolmcdf((c)*sqrt(m*n/(m+n)));

TNR = 1 - FPR;

while (1-Hc(end) > FPR) || (1-Hdc(end) > TNR)
    n = n +1;
    m = m + 1;
    X(end + 1) = normrnd(F(1),F(2));
    Y(end + 1) = normrnd(G(1),G(2));
    [Fn,x_f] = ecdf(X);
    [Gn,x_g] = ecdf(Y);
    Hdc(end + 1) = kolmcdf((D-c)*sqrt(m*n/(m+n)));
    Hc(end + 1) = kolmcdf((c)*sqrt(m*n/(m+n)));
end


delta = max(abs(y_f-y_g));

if plotOn
    plot(xx, abs(y_f-y_g));
    ylabel('$\parallel \mathbf{F}_{n}-\mathbf{G}_n \parallel_{\infty}$','Interpreter','latex')
    xlabel('$x$','Interpreter','latex')
    figure(2)
    h1 = stairs(x_f,Fn);
    hold on
    plot(xx,y_f,':.')
    h2 = stairs(x_g,Gn);
    plot(xx,y_g,':.')
    legend([h1;h2],{'$\mathbf{F}_n(x)$','$\mathbf{G}_n(x)$'},'Interpreter','latex')
    xlabel('$x$','Interpreter','latex')
    ylabel('ECDF')
end
if delta <= c
    A = 1;
else
    A = 0;
end